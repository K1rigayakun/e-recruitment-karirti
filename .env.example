APP_NAME="KarirTI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=karirti
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

CACHE_STORE=database
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@karirti.test"
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log

CV_MAX_KB=2048
ADMIN_EMAIL=admin@karirti.test
ADMIN_PASSWORD=
